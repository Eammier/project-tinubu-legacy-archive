generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  EDITOR
  REVIEWER
  MINISTRY_OFFICER
  PUBLIC_USER
}

enum ProjectStatus {
  DRAFT
  REVIEW
  VERIFICATION
  APPROVED
  PUBLISHED
  COMPLETED
  ONGOING
  PLANNED
  SUSPENDED
}

enum Sector {
  INFRASTRUCTURE
  HEALTHCARE
  EDUCATION
  AGRICULTURE
  HOUSING
  TRANSPORTATION
  WATER
  TECHNOLOGY
  POWER
  SECURITY
  SOCIAL_INVESTMENT
  ENVIRONMENT
}

enum FeedbackType {
  FEEDBACK
  INACCURACY
  EVIDENCE
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

enum MediaType {
  PHOTO
  VIDEO
  DRONE
  DOCUMENT
  BEFORE_AFTER
  VIRTUAL_TOUR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(PUBLIC_USER)
  ministry      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]       @relation("CreatedBy")
  feedback      Feedback[]
  activityLogs  ActivityLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String
  budget          Float
  fundingSource   String
  ministry        String
  state           String
  lga             String
  latitude        Float?
  longitude       Float?
  startDate       DateTime
  completionDate  DateTime?
  status          ProjectStatus @default(DRAFT)
  progress        Int           @default(0)
  sector          Sector
  contractor      String?
  consultants     String?
  beneficiaries   Int?
  impactMetrics   Json?
  heroImage       String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  publishedAt     DateTime?

  createdBy       User          @relation("CreatedBy", fields: [createdById], references: [id])
  media           Media[]
  documents       Document[]
  feedback        Feedback[]
  relatedFrom     RelatedProject[] @relation("ProjectFrom")
  relatedTo       RelatedProject[] @relation("ProjectTo")
  timeline        TimelineEntry[]
}

model Media {
  id          String    @id @default(cuid())
  projectId   String
  type        MediaType
  title       String
  url         String
  thumbnail   String?
  caption     String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Document {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  type        String
  url         String
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RelatedProject {
  id          String  @id @default(cuid())
  projectId   String
  relatedId   String

  project     Project @relation("ProjectFrom", fields: [projectId], references: [id], onDelete: Cascade)
  related     Project @relation("ProjectTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([projectId, relatedId])
}

model TimelineEntry {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  date        DateTime
  order       Int      @default(0)

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Feedback {
  id          String         @id @default(cuid())
  projectId   String
  userId      String?
  type        FeedbackType
  message     String
  evidenceUrl String?
  status      FeedbackStatus @default(PENDING)
  response    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  entity      String
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}
